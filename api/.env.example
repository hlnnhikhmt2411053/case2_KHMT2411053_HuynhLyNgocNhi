PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/taskmanager_case2
# Tạo bí mật ngẫu nhiên ít nhất 32 ký tự. KHÔNG commit .env.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Gmail: dùng App Password qua biến môi trường, không nhập mật khẩu Gmail thường.
# Để trống SMTP_* nếu chưa cấu hình; email sẽ ở trạng thái pending, không giả vờ gửi.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Tùy chọn nhắc hạn 24 giờ (mặc định tắt)
ENABLE_REMINDERS=false
